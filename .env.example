# Copy this file to .env (which is gitignored) and fill in your Neon "dev"
# branch's pooled connection string -- see the Connection Details panel in
# the Neon dashboard, using the "-pooler" hostname variant.
#
# Without this file, the app falls back to the original JSON-file storage
# under data/ -- so it's safe to leave unset until Neon is provisioned.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.region.aws.neon.tech/dbname?sslmode=require
