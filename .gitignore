__pycache__/
*.pyc
.venv/
venv/
.DS_Store

# local Neon connection string -- never commit real credentials
.env

# runtime-grown caches (seed files ARE committed; these are what the server
# writes to at runtime and can just regrow from the seed on next deploy)
data/geocode_cache.json
data/distance_cache.json

# user-submitted quote feedback (accurate/comment) -- accumulates locally,
# reviewed and folded into manual_quotes.json / training data by hand
data/feedback.json

# lock files + atomic-write temp files used by the locked read-merge-write
# helpers in app/main.py and app/geocode.py -- never meant to be committed
data/*.lock
data/*.tmp.*
